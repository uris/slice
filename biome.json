{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"ignore": [
			"**/node_modules/**",
			"**/dist/**",
			"**/.build/**",
			"**/storybook-static/**",
			"**/storybook-native-static/**",
			"**/build/**",
			"**/public/**",
			"**/coverage/**",
			"**/reports/**",
			"**/pack/**",
			"**/.next/**",
			"**/out/**",
			"**/benchmarks/**",
			"**/platform/ios/Resources/**",
			"**/*.smoketest.tsx",
			"**/*.test.ts",
			"**/*.test.tsx",
			"**/*.spec.ts",
			"**/*.spec.tsx",
			"**/next-env.d.ts"
		],
		"include": [
			"**/*.js",
			"**/*.jsx",
			"**/*.mjs",
			"**/*.cjs",
			"**/*.ts",
			"**/*.tsx",
			"**/*.mts",
			"**/*.cts",
			"**/*.json",
			"**/*.jsonc",
			"**/*.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"organizeImports": {
		"enabled": true
	},
	"css": {
		"parser": {
			"cssModules": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "off",
				"noImplicitAnyLet": "error"
			},
			"style": {
				"useImportType": "error"
			},
			"a11y": {
				"useSemanticElements": "off",
				"useValidAriaRole": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"json": {
		"parser": {
			"allowComments": true
		}
	}
}
