{
	"name": "slice-monorepo",
	"private": true,
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"build": "npm run build --workspace=@apple-pie/slice --",
		"build:min": "npm run build:min --workspace=@apple-pie/slice --",
		"test": "npm run test --workspace=@apple-pie/slice --",
		"test:ui": "npm run test:ui --workspace=@apple-pie/slice --",
		"coverage": "npm run coverage --workspace=@apple-pie/slice --",
		"benchmark": "npm run benchmark --workspace=@apple-pie/slice --",
		"benchmark:raw": "npm run benchmark:raw --workspace=@apple-pie/slice --",
		"benchmark:watch": "npm run benchmark:watch --workspace=@apple-pie/slice --",
		"benchmark:ui": "npm run benchmark:ui --workspace=@apple-pie/slice --",
		"pack:tarball": "npm run pack:tarball --workspace=@apple-pie/slice --",
		"typecheck": "npm run typecheck --workspace=@apple-pie/slice --",
		"dev": "npm run storybook",
		"storybook": "npm run dev --workspace=@slice/storybook-web --",
		"build-storybook": "npm run build --workspace=@slice/storybook-web --",
		"storybook:native": "npm run dev --workspace=@slice/storybook-native --",
		"build-storybook:native": "npm run build --workspace=@slice/storybook-native --",
		"typecheck:storybook:native": "npm run typecheck --workspace=@slice/storybook-native --",
		"dev:landing": "npm run dev --workspace=@slice/website --",
		"build:landing": "npm run build --workspace=@slice/website --",
		"typecheck:landing": "npm run typecheck --workspace=@slice/website --",
		"format": "biome format --write .",
		"lint": "biome format --write . && biome check . && npm run typecheck:all",
		"lint:fix": "biome format --write . && biome check --write . && npm run typecheck:all",
		"lint:ci": "biome ci . && npm run typecheck:all",
		"typecheck:all": "npm run typecheck --workspaces --if-present"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"typescript": "^5.7.3",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"overrides": {
		"rollup-plugin-postcss": {
			"postcss-selector-parser": "^7.1.6"
		}
	}
}
