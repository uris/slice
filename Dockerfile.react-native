# syntax=docker/dockerfile:1
# Separate Dockerfile prevents legacy builders from running native stages when
# building the landing page or React docs.
FROM node:24-alpine AS native-build
WORKDIR /app
COPY package*.json ./
COPY packages/slice/package.json ./packages/slice/package.json
COPY packages/slice-native/package.json ./packages/slice-native/package.json
COPY apps/website/package.json ./apps/website/package.json
COPY apps/storybook-web/package.json ./apps/storybook-web/package.json
COPY apps/storybook-native/package.json ./apps/storybook-native/package.json
RUN node -e "if (!require('./package.json').scripts['build-storybook:native']) { console.error('Native docs are not configured: add build-storybook:native before deploying react-native-docs.'); process.exit(1); }"
RUN npm ci
COPY . .
RUN npm run build-storybook:native -- --output-dir /app/apps/storybook-native/storybook-static

FROM nginx:alpine AS react-native-docs
COPY --from=native-build /app/apps/storybook-native/storybook-static/ /usr/share/nginx/html/
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
