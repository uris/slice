{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"target": "ES2020",
		"noEmit": false,
		"noEmitOnError": true,
		"emitDeclarationOnly": false,
		"declaration": true,
		"declarationDir": "./dist/types",
		"rootDir": "..",
		"outDir": "./.build",
		"types": ["react"]
	},
	"include": ["index.ts", "components/**/*.ts", "components/**/*.tsx", "theme/**/*.ts"],
	"exclude": ["**/*.test.ts", "**/*.test.tsx", "dist", ".build", "node_modules"]
}
