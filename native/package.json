{
	"name": "@apple-pie/slice-native",
	"version": "0.1.5",
	"description": "React Native icons and design tokens for Slice",
	"author": "Uris Dacosta",
	"license": "ISC",
	"type": "commonjs",
	"main": "./dist/cjs/index.js",
	"module": "./dist/esm/index.mjs",
	"react-native": "./dist/esm/index.mjs",
	"types": "./dist/types/native/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/native/index.d.ts",
			"react-native": "./dist/esm/index.mjs",
			"import": "./dist/esm/index.mjs",
			"require": "./dist/cjs/index.js"
		},
		"./package.json": "./package.json",
		"./theme": {
			"types": "./dist/types/native/src/theme/index.d.ts",
			"react-native": "./dist/esm/theme.mjs",
			"import": "./dist/esm/theme.mjs",
			"require": "./dist/cjs/theme.js"
		},
		"./components": {
			"types": "./dist/types/native/src/components/index.d.ts",
			"react-native": "./dist/esm/components.mjs",
			"import": "./dist/esm/components.mjs",
			"require": "./dist/cjs/components.js"
		},
		"./hooks": {
			"types": "./dist/types/native/src/hooks/index.d.ts",
			"react-native": "./dist/esm/hooks.mjs",
			"import": "./dist/esm/hooks.mjs",
			"require": "./dist/cjs/hooks.js"
		},
		"./providers": {
			"types": "./dist/types/native/src/providers/index.d.ts",
			"react-native": "./dist/esm/providers.mjs",
			"import": "./dist/esm/providers.mjs",
			"require": "./dist/cjs/providers.js"
		},
		"./utils": {
			"types": "./dist/types/native/src/utils/index.d.ts",
			"react-native": "./dist/esm/utils.mjs",
			"import": "./dist/esm/utils.mjs",
			"require": "./dist/cjs/utils.js"
		}
	},
	"files": ["dist"],
	"sideEffects": false,
	"scripts": {
		"test": "vitest run --config vitest.config.mts",
		"test:package": "npm run build && node scripts/check-package.mjs",
		"coverage": "vitest run --config vitest.config.mts --coverage",
		"lint": "biome format --write . && biome check . && npm run typecheck",
		"lint:ci": "biome ci . && npm run typecheck",
		"build": "npm run generate && node scripts/build.mjs",
		"pack:tarball": "node scripts/pack.mjs",
		"pack": "node scripts/pack.mjs",
		"prepack": "npm run build",
		"generate": "node scripts/generate-icons.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": ["react-native", "icons", "svg", "apple-pie"],
	"devDependencies": {
		"rollup": "^4.32.0",
		"typescript": "^5.7.3",
		"vitest": "^4.0.18"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-native": ">=0.80.0 <1.0.0",
		"react-native-svg": "^15.0.0",
		"react-native-reanimated": "^4.0.0"
	}
}
